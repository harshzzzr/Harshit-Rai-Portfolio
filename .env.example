# Firebase Configuration
# Replace with your actual Firebase Web App credentials from the Firebase Console:
# Firebase Console -> Project settings -> General -> Your apps -> Web app -> SDK setup and configuration
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Local Development Demo Mode (Set to 'true' to use local offline mode without Firebase credentials)
VITE_ENABLE_DEMO_AUTH=false
VITE_ENABLE_DEMO_DATA=false

# GitHub API Integration (Uses public GitHub REST API; no client-side secret token required)
VITE_GITHUB_USERNAME=harshzzzr
VITE_GITHUB_URL=https://github.com/harshzzzr

# LinkedIn Profile Link (LinkedIn does not use a public API key for portfolio display)
VITE_LINKEDIN_URL=https://www.linkedin.com/in/harshit-rai-/

# LeetCode Stats Integration (Uses public proxy APIs by default; no user API key required)
VITE_LEETCODE_USERNAME=GkKWasfX4F
VITE_LEETCODE_URL=https://leetcode.com/u/GkKWasfX4F/
# VITE_LEETCODE_API_ENDPOINT=https://alfa-leetcode-api.onrender.com/userProfile/{username}

# Spotify Integration
# Note: Spotify Web API requires OAuth 2.0 user tokens. Live streaming uses an optional backend proxy endpoint.
# Without an endpoint, the portfolio gracefully displays curated coding flow soundtracks.
VITE_SPOTIFY_URL=https://open.spotify.com/user/31b6a5xevyjjpxunwv3fr2f662mu
VITE_SPOTIFY_USERNAME=31b6a5xevyjjpxunwv3fr2f662mu
# VITE_SPOTIFY_NOW_PLAYING_ENDPOINT=https://your-serverless-function.vercel.app/api/spotify

