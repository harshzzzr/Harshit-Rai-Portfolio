rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper to check authentication
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public asset files: read by anyone, write/delete by admin only
    match /profile/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /projects/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /screenshots/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /certificates/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /resume/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Fallback rule
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
