rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper to verify authenticated admin user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Public portfolio data: public read, admin-only write
    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /skills/{skillId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /education/{educationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /experience/{experienceId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /timeline/{timelineId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /achievements/{achievementId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /certifications/{certificationId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Contact messages: public create with strict validation, admin-only read/update/delete
    match /messages/{messageId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'email', 'subject', 'message', 'status', 'createdAt', 'createdAtIso'])
                    && request.resource.data.name is string 
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() >= 5
                    && request.resource.data.email.size() <= 150
                    && request.resource.data.email.matches('^[^@]+@[^@]+\\.[a-zA-Z]{2,}$')
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() >= 3
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 10
                    && request.resource.data.message.size() <= 3000
                    && request.resource.data.status == 'unread';
      allow read, update, delete: if isAuthenticated();
    }

    // Testimonials / Feedback: public submit (pending), approved read publicly, admin moderation
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'rating', 'feedback', 'status', 'createdAt', 'createdAtIso'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.feedback is string
                    && request.resource.data.feedback.size() >= 5
                    && request.resource.data.feedback.size() <= 1000
                    && request.resource.data.status == 'pending';
      allow read: if resource.data.status == 'approved' || isAuthenticated();
      allow update, delete: if isAuthenticated();
    }

    // Default deny for unmapped documents
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
